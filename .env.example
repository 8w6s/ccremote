# ===== Discord =====

# Bot token from https://discord.com/developers/applications → Bot → Reset Token
BOT_TOKEN=

# Application ID (also called CLIENT_ID) — used to deploy slash commands.
CLIENT_ID=

# Guild ID where the bot runs. The bot is guild-only and single-tenant.
GUILD_ID=

# Discord user ID of the owner. Only the owner (and team members added via /team)
# can prompt the bot. Enable Developer Mode in Discord (Settings → Advanced),
# then right-click your avatar → Copy User ID.
OWNER_ID=

# Text channel ID of the "hub" — the bot posts an embed here with a
# [New Session] button. Create a text channel in your guild and copy its ID.
HUB_CHANNEL_ID=

# Category ID — the bot creates new session channels inside this category.
# Create an empty category and copy its ID.
CATEGORY_ID=

# Optional. If set, /close moves the channel into this category instead of
# leaving it in CATEGORY_ID.
ARCHIVE_CATEGORY_ID=

# ===== Anthropic / Claude Code (optional) =====

# If left empty, `claude` CLI uses your local default auth (OAuth/keychain/
# subscription). Only set these to override to a custom endpoint / API key.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# ===== Runtime config =====

# Default working directory when a new session is created.
DEFAULT_CWD=/home/YOU/PROJECTS

# Comma-separated list of allowed cwd prefixes. /cwd refuses anything else.
ALLOWED_CWD_PREFIXES=/home/YOU/PROJECTS,/tmp

# Per-channel prompt rate limit (per hour) to prevent runaway.
MAX_PROMPTS_PER_HOUR=60

# Attachment caps (bytes). Discord's free tier upload cap is 25 MB.
MAX_ATTACHMENT_BYTES=26214400

# Inline image caps: 5 MB per image, 5 images per message (Anthropic Vision).
MAX_IMAGE_BYTES=5242880
MAX_INLINE_IMAGES=5

# Text/code attachments at or below this size are inlined into the prompt.
MAX_INLINE_TEXT_BYTES=262144

# Abort a Discord attachment download after this many milliseconds.
ATTACHMENT_DOWNLOAD_TIMEOUT_MS=30000
